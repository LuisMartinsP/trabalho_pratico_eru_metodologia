# Copie este arquivo para .env e preencha com as suas chaves.
# O .env NÃO vai para o git (está no .gitignore); este .env.example vai,
# para documentar quais variáveis o projeto espera.

# Google Gemini: chave gerada em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Outras LLMs (preencher quando forem adicionadas ao estudo)
# OpenAI: chave gerada em https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic (Claude): chave gerada em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Os modelos e parâmetros de geração ficam em config/modelos.yaml.
