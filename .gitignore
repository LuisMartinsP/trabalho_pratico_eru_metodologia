# Ambiente virtual
.venv/

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/

# Cópias de repositórios e downloads grandes (regeráveis pelos scripts)
dados/*
# As respostas das LLMs (gemini-2.5-flash, gpt-5-mini) ficam só localmente;
# serão adicionadas ao repositório depois.
# Exceção: o banco SQLite (gerado por src/08_banco.py) reúne as tabelas e o código das
# soluções num arquivo só.
!dados/estudo.sqlite
# Exceção: os resultados das consultas ao banco, exportados em CSV (com e sem documentação)
!dados/views_csv/
dados/views_csv/_anteriores/

# Chaves de API (nunca versionar)
.env
